# ---------------------------------------------------------------------------
# Copy this file to a new file named `.env` and fill in the values.
#
# IMPORTANT: every variable that starts with VITE_ is bundled into the website
# and is visible to anyone. Only put PUBLIC keys here (the Supabase "anon" key
# is designed to be public). NEVER put a secret model key in a VITE_ variable —
# the Gemini key goes in a separate server-only variable (see the bottom).
#
# With everything blank, the app runs on built-in demo data.
# ---------------------------------------------------------------------------

# --- Supabase (database + login) ---
# From Supabase dashboard: Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Require coach sign-in before using the app. Leave blank while testing; set to
# the word  true  once Supabase auth is set up to lock down data entry.
VITE_REQUIRE_AUTH=

# --- AI note expansion (points the app at the serverless function) ---
# After deploying to Vercel, set this to:  /api/expand
VITE_AI_ENDPOINT=

# --- Server-only secret (NOT prefixed with VITE_) ---
# The Google Gemini API key, used ONLY by api/expand.ts on the server.
# Set this in Vercel's Environment Variables, not in a VITE_ variable.
GEMINI_API_KEY=

# --- Google Sheets (optional legacy read path — ignored if Supabase is set) ---
VITE_GOOGLE_SHEET_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_SHEET_RANGE=Assessments!A1:Z1000
